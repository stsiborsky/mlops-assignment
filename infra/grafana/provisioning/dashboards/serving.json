{
  "title": "vLLM serving",
  "uid": "vllm-serving",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "tags": ["vllm", "assignment"],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests running vs waiting",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "vllm:num_requests_running", "legendFormat": "running" },
        { "expr": "vllm:num_requests_waiting", "legendFormat": "waiting" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput (Tokens/s)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(vllm:generation_tokens_total[1m])", "legendFormat": "generation" },
        { "expr": "rate(vllm:prompt_tokens_total[1m])", "legendFormat": "prompt" }
      ],
      "fieldConfig": { "defaults": { "unit": "pps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "KV Cache Usage (%)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "vllm:kv_cache_usage_perc * 100", "legendFormat": "GPU KV Cache %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "E2E Request Latency",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "P99" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "P50" },
        { "expr": "sum(rate(vllm:e2e_request_latency_seconds_sum[5m])) / sum(rate(vllm:e2e_request_latency_seconds_count[5m]))", "legendFormat": "Mean" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last", "max"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Inter-token Latency",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "legendFormat": "P99" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "legendFormat": "P50" },
        { "expr": "sum(rate(vllm:inter_token_latency_seconds_sum[5m])) / sum(rate(vllm:inter_token_latency_seconds_count[5m]))", "legendFormat": "Mean" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last", "max"] } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Preemptions & Request Rates",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(vllm:num_preemptions_total[5m])", "legendFormat": "preemptions/s" },
        { "expr": "rate(vllm:request_success_total[5m])", "legendFormat": "success requests/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
